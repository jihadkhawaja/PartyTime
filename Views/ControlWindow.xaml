<Window x:Class="PartyTime.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PartyTime.Controls"
        Title="PartyTime" Icon="/Assets/PartyTime-v2.ico"
        Width="584" Height="744" MinWidth="510" MinHeight="510"
        WindowStartupLocation="CenterScreen" Background="#100E19" Foreground="#F4EFFF"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Muted" Color="#B9B0CB"/>
            <SolidColorBrush x:Key="Accent" Color="#D4BDFF"/>
            <SolidColorBrush x:Key="Panel" Color="#1A1525"/>
            <SolidColorBrush x:Key="PanelBorder" Color="#362A49"/>
            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            </Style>
            <Style x:Key="HelpText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="Primary" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="MinWidth" Value="124"/>
                <Setter Property="Background" Value="#C6A8FF"/>
                <Setter Property="Foreground" Value="#211132"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fill" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="Background" Value="#DDCAFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fill" Property="Background" Value="#AF8FEB"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Fill" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Choice" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#F4EFFF"/>
                <Setter Property="Padding" Value="4,5"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card" Padding="{TemplateBinding Padding}" CornerRadius="7"
                                    Background="#241D30" BorderBrush="#40364F" BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#372A49"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#BEA0FC"/>
                                    <Setter TargetName="Card" Property="Background" Value="#3B2854"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#E9D9FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SettingsTabs" TargetType="TabControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,8">
                                    <UniformGrid IsItemsHost="True" Rows="1" KeyboardNavigation.TabIndex="0"/>
                                </Border>
                                <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1" CornerRadius="11" KeyboardNavigation.TabIndex="1">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Tab" CornerRadius="6" Padding="8,6" Margin="1,0" MinHeight="32"
                                    Background="Transparent" BorderThickness="1">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="#291F38"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="#392952"/>
                                    <Setter TargetName="Tab" Property="BorderBrush" Value="#68528A"/>
                                    <Setter Property="Foreground" Value="#F4E9FF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Tab" Property="BorderBrush" Value="#D4BDFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#211B2C"/>
                <Setter Property="Foreground" Value="#F4EFFF"/>
                <Setter Property="CaretBrush" Value="#F4EFFF"/>
                <Setter Property="BorderBrush" Value="#524464"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Selection" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#F4EFFF"/>
                <Setter Property="Background" Value="#241D30"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Margin" Value="0,3,0,9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" Background="{TemplateBinding Background}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="#66577C" BorderThickness="1" CornerRadius="6"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="SelectionContent" Margin="10,5,26,5" VerticalAlignment="Center" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"/>
                                <TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                    <Border Background="#241D30" BorderBrush="#66577C" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SelectedIndex" Value="-1">
                                    <Setter TargetName="SelectionContent" Property="Content" Value="Mixed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#F4EFFF"/>
                            <Setter Property="Padding" Value="9,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#493263"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#392952"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Swatch" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="#80798C"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="BorderBrush" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,19,24,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.28*" MinHeight="94" MaxHeight="144"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="13" Padding="15,11" Margin="0,0,0,11" BorderThickness="1" BorderBrush="#46355E">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#342053" Offset="0"/>
                    <GradientStop Color="#211A36" Offset="0.62"/>
                    <GradientStop Color="#19283E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,11,0" CornerRadius="11"
                                BorderThickness="1" Background="#2B2045">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E48DFF" Offset="0"/>
                                    <GradientStop Color="#42E2FA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Path Data="M 0,8 L 7,8 11,0 16,16 22,3 26,8 33,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource Accent}" StrokeThickness="2.5" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Eyebrow}" Text="DESKTOP VISUALIZER"/>
                            <TextBlock Text="PartyTime" FontSize="28" FontWeight="Bold" Margin="-1,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#8D829E" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusTitle" Text="Party is off" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusDetail" Text="Play music, then start the overlay."
                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="PartyButton" Style="{StaticResource Primary}" Content="Start _party"
                        VerticalAlignment="Center" Click="ToggleClicked"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="11,8,11,10" Margin="0,0,0,11" CornerRadius="11" BorderThickness="1"
                BorderBrush="{StaticResource PanelBorder}" Background="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="1,0,1,7">
                    <TextBlock DockPanel.Dock="Right" Text="Sample motion" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock Text="STYLE PREVIEW" Style="{StaticResource Eyebrow}"/>
                </DockPanel>
                <controls:StylePreview Grid.Row="1" x:Name="Preview" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource SettingsTabs}" AutomationProperties.Name="PartyTime settings">
            <TabItem Header="Visuals">
                <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <TextBlock Text="VISUAL PRESETS" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                        <DockPanel Margin="0,0,0,7">
                            <Button x:Name="ApplyPresetButton" DockPanel.Dock="Right" Content="Apply preset" Style="{StaticResource Primary}" Click="ApplyPresetClicked"/>
                            <ComboBox x:Name="PresetPicker" Style="{StaticResource Selection}" Margin="0,0,9,0" SelectionChanged="PresetSelected" AutomationProperties.Name="Visual preset"/>
                        </DockPanel>
                        <TextBlock x:Name="PresetDescription" Style="{StaticResource HelpText}" Margin="0,0,0,12"/>
                        <TextBlock Text="Mix these layers with shapes and cursor effects in Motion." Style="{StaticResource HelpText}" Margin="0,0,0,10"/>
                        <TextBlock Text="BARS &amp; WAVES" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                        <UniformGrid x:Name="StyleChoices" Columns="4" Margin="0,0,-6,0">
                            <RadioButton GroupName="VisualStyle" Tag="None" Content="None" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="VisualStyle" Tag="EdgeBars" Content="Edge bars" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Spectrum bars along the top and bottom."/>
                            <RadioButton GroupName="VisualStyle" Tag="CenterBars" Content="Center bars" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="A mirrored equalizer across the middle of the screen."/>
                            <RadioButton GroupName="VisualStyle" Tag="Wave" Content="Wave" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="A smooth spectrum ribbon across the middle of the screen."/>
                        </UniformGrid>
                        <TextBlock Text="CIRCLE" Style="{StaticResource Eyebrow}" Margin="0,4,0,6"/>
                        <UniformGrid x:Name="CircleChoices" Columns="5" Margin="0,0,-6,0">
                            <RadioButton GroupName="CircleStyle" Tag="None" Content="None" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="CircleStyle" Tag="Orbit" Content="Orbit" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="A pulsing ring with radial spectrum bars."/>
                            <RadioButton GroupName="CircleStyle" Tag="PulseRings" Content="Pulse rings" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Three concentric rings that expand on beats."/>
                            <RadioButton GroupName="CircleStyle" Tag="RadialWave" Content="Radial wave" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="A continuous circle that bends with the spectrum."/>
                            <RadioButton GroupName="CircleStyle" Tag="DotHalo" Content="Dot halo" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="A ring of dots that change size and distance with the spectrum."/>
                        </UniformGrid>
                        <TextBlock Text="BORDER" Style="{StaticResource Eyebrow}" Margin="0,4,0,6"/>
                        <UniformGrid x:Name="BorderChoices" Columns="5" Margin="0,0,-6,0">
                            <RadioButton GroupName="BorderStyle" Tag="None" Content="None" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="BorderStyle" Tag="Glow" Content="Glow" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="A soft glow that fades inward from the screen edges."/>
                            <RadioButton GroupName="BorderStyle" Tag="DoubleRail" Content="Double rail" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Two rounded outlines that spread apart with the beat."/>
                            <RadioButton GroupName="BorderStyle" Tag="Corners" Content="Corners" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Four brackets that grow on beats."/>
                            <RadioButton GroupName="BorderStyle" Tag="Marquee" Content="Marquee" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Animated dashes that chase around the edges."/>
                        </UniformGrid>
                        <TextBlock Text="OVERLAY EFFECT" Style="{StaticResource Eyebrow}" Margin="0,4,0,6"/>
                        <UniformGrid x:Name="OverlayChoices" Columns="5" Margin="0,0,-6,0">
                            <RadioButton GroupName="OverlayStyle" Tag="None" Content="None" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="OverlayStyle" Tag="BeatRipple" Content="Beat ripple" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="A fading outline that ripples in from the edges on beats."/>
                            <RadioButton GroupName="OverlayStyle" Tag="CornerBloom" Content="Bloom" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Soft washes of color that bloom from the corners."/>
                            <RadioButton GroupName="OverlayStyle" Tag="Sparks" Content="Sparks" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Drifting points of light that brighten on beats."/>
                            <RadioButton GroupName="OverlayStyle" Tag="LightSweep" Content="Light sweep" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="A soft band of light that sweeps down the screen."/>
                        </UniformGrid>
                        <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,4,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock x:Name="IntensityValue" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12"/>
                                    <TextBlock Text="Intensity" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="IntensitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" AutomationProperties.Name="Intensity" ToolTip="How bright the overlay appears." ValueChanged="SettingsChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12"/>
                                    <TextBlock Text="Size" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="SizeSlider" Minimum="60" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" AutomationProperties.Name="Size" ToolTip="How far the effect spreads across the screen." ValueChanged="SettingsChanged"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="OVERLAY FRAME RATE" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/>
                        <UniformGrid x:Name="FrameRateChoices" Columns="5" Margin="0,0,-6,1">
                            <RadioButton GroupName="FrameRate" Tag="Fps20" Content="20 FPS" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrameRate" Tag="Fps30" Content="30 FPS" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrameRate" Tag="Fps45" Content="45 FPS" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrameRate" Tag="Fps60" Content="60 FPS" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrameRate" Tag="MatchDisplay" Content="Match display" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Use the refresh rate Windows reports for each display."/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource HelpText}" Text="Music effects use this frame rate. Match display targets each screen’s refresh rate. Cursor trails update independently."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Images">
                <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <TextBlock Text="YOUR OVERLAY IMAGES" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                        <TextBlock Text="Add PNG, JPEG, or BMP images as stickers, halos, or floating particles. Each image can follow its own audio range." Style="{StaticResource HelpText}" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="AddImageButton" Content="Add image…" Style="{StaticResource Primary}" Click="AddImageClicked" Margin="0,0,8,0"/>
                            <Button x:Name="RemoveImageButton" Content="Remove image" Style="{StaticResource Primary}" Click="RemoveImageClicked" Margin="0,0,8,0"/>
                            <Button x:Name="SelectAllImagesButton" Content="Select all" Style="{StaticResource Primary}" Click="SelectAllImagesClicked"/>
                        </WrapPanel>
                        <TextBlock x:Name="ImageError" Foreground="#FFC28C" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <ListBox x:Name="ImageList" DisplayMemberPath="Name" SelectionMode="Extended" SelectionChanged="ImageSelected" PreviewKeyDown="ImageListKeyDown" MaxHeight="110" MinHeight="40"
                                 Background="#211B2C" Foreground="#F4EFFF" BorderBrush="#524464" AutomationProperties.Name="Overlay images"/>
                        <TextBlock Text="Ctrl+click to select several, Shift+click for a range, or use Select all." Style="{StaticResource HelpText}" Margin="0,5,0,0"/>
                        <TextBlock x:Name="ImageSelectionSummary" Style="{StaticResource HelpText}" Margin="0,5,0,0"/>
                        <StackPanel x:Name="ImageEditor" Visibility="Collapsed" Margin="0,12,0,0">
                            <CheckBox x:Name="ImageEnabled" Content="Show this image" Checked="ImageSettingsChanged" Unchecked="ImageSettingsChanged" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ImageNameLabel" Text="Image name"/>
                            <TextBox x:Name="ImageName" MaxLength="80" TextChanged="ImageSettingsChanged" Margin="0,3,0,9" AutomationProperties.Name="Image name"/>
                            <TextBlock Text="IMAGE PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,2,0,6"/>
                            <Border Height="144" CornerRadius="6" BorderBrush="#524464" BorderThickness="1" ClipToBounds="True">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#302839" Geometry="M0,0 H16 V16 H0 Z"/>
                                                <GeometryDrawing Brush="#493F55" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                                <Image x:Name="ImagePreview" Stretch="Uniform" MouseLeftButtonDown="ImagePreviewClicked"
                                       AutomationProperties.Name="Image preview" ToolTip="Use Pick from image, then click a visible color in this preview."/>
                            </Border>
                            <TextBlock x:Name="ImagePreviewHint" Style="{StaticResource HelpText}" Margin="0,5,0,9"/>
                            <CheckBox x:Name="ImageChromaKey" Content="Remove a color (chroma key)" Checked="ImageSettingsChanged" Unchecked="ImageSettingsChanged"/>
                            <StackPanel x:Name="ChromaKeyControls" Margin="0,6,0,10">
                                <TextBlock x:Name="ImageKeyColorMixed" Text="Key color · Mixed" Style="{StaticResource HelpText}" Visibility="Collapsed" Margin="0,0,0,5"/>
                                <WrapPanel>
                                    <Button x:Name="PickImageColorButton" Content="Pick from image" Style="{StaticResource Primary}" Click="PickImageColorClicked" Margin="0,0,9,5"/>
                                    <Border x:Name="ImageKeySwatch" Width="28" Height="28" BorderBrush="#80798C" BorderThickness="1" CornerRadius="4" Margin="0,0,7,5"/>
                                    <TextBox x:Name="ImageKeyColor" Width="88" MaxLength="7" TextChanged="ImageSettingsChanged" Margin="0,0,0,5" AutomationProperties.Name="Chroma key hex color"/>
                                </WrapPanel>
                                <TextBlock x:Name="ImageKeyColorError" Text="Enter six hex digits, for example #00FF00." Foreground="#FFC28C" Visibility="Collapsed" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ImageKeyToleranceLabel"/>
                                <Slider x:Name="ImageKeyTolerance" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ImageSettingsChanged" AutomationProperties.Name="Chroma key tolerance"/>
                                <TextBlock Text="Higher tolerance removes more similar colors. The original image is kept." Style="{StaticResource HelpText}"/>
                            </StackPanel>
                            <TextBlock Text="Placement"/>
                            <ComboBox x:Name="ImagePlacement" Style="{StaticResource Selection}" SelectionChanged="ImageSettingsChanged" AutomationProperties.Name="Image placement"/>
                            <TextBlock x:Name="ImagePlacementHelp" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                            <TextBlock Text="React to"/>
                            <ComboBox x:Name="ImageReaction" Style="{StaticResource Selection}" SelectionChanged="ImageSettingsChanged" AutomationProperties.Name="Image audio range"/>
                            <TextBlock x:Name="ImageSizeLabel" Margin="0,6,0,0"/>
                            <Slider x:Name="ImageSize" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ImageSettingsChanged" AutomationProperties.Name="Image size"/>
                            <TextBlock x:Name="ImageOpacityLabel" Margin="0,6,0,0"/>
                            <Slider x:Name="ImageOpacity" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ImageSettingsChanged" AutomationProperties.Name="Image opacity"/>
                            <StackPanel x:Name="ImageCountPanel">
                                <TextBlock x:Name="ImageCountLabel" Margin="0,6,0,0"/>
                                <Slider x:Name="ImageCount" Minimum="1" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ImageSettingsChanged" AutomationProperties.Name="Image copies"/>
                            </StackPanel>
                            <StackPanel x:Name="ImagePositionPanel">
                                <TextBlock x:Name="ImageXLabel" Margin="0,6,0,0"/>
                                <Slider x:Name="ImageX" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ImageSettingsChanged" AutomationProperties.Name="Image horizontal position"/>
                                <TextBlock x:Name="ImageYLabel" Margin="0,6,0,0"/>
                                <Slider x:Name="ImageY" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ImageSettingsChanged" AutomationProperties.Name="Image vertical position"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Screen">
                <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <TextBlock Text="BEAT-SYNCED SCREEN SAMPLES" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                        <CheckBox x:Name="ScreenSamplesToggle" Content="Overlay screen samples" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Freeze a screenshot from each display, pulse it with the music, then jump to a fresh sample after the chosen number of beats." Style="{StaticResource HelpText}" Margin="0,5,0,10"/>
                        <StackPanel x:Name="ScreenSamplesPanel" Visibility="Collapsed">
                            <TextBlock Text="Overlay effect"/>
                            <ComboBox x:Name="SampleBlendPicker" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Screen sample blend effect"/>
                            <TextBlock x:Name="SampleBlendDescription" Style="{StaticResource HelpText}" Margin="0,0,0,9"/>
                            <TextBlock Text="Beat source"/>
                            <ComboBox x:Name="SampleReactionPicker" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Screen sample beat source"/>
                            <TextBlock x:Name="SampleBeatsLabel"/>
                            <Slider x:Name="SampleBeatsSlider" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Beats per screen sample"/>
                            <TextBlock x:Name="SampleOpacityLabel" Margin="0,7,0,0"/>
                            <Slider x:Name="SampleOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Screen sample opacity"/>
                            <TextBlock x:Name="SampleZoomLabel" Margin="0,7,0,0"/>
                            <Slider x:Name="SampleZoomSlider" Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Screen sample beat zoom"/>
                            <TextBlock x:Name="SampleFadeLabel" Margin="0,7,0,0"/>
                            <Slider x:Name="SampleFadeSlider" Minimum="150" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Screen sample fade time"/>
                        </StackPanel>
                        <Border x:Name="SamplePreviewHost" Background="#090810" CornerRadius="7" Margin="0,12,0,7" ClipToBounds="True">
                            <Image x:Name="SamplePreview" Height="116" Stretch="Uniform" AutomationProperties.Name="Primary display screen sample preview"/>
                        </Border>
                        <TextBlock x:Name="SampleStatus" Style="{StaticResource HelpText}"/>
                        <TextBlock Text="Samples stay in memory and clear when stopped. Screen sampling excludes PartyTime from screenshots and recordings to prevent feedback." Style="{StaticResource HelpText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Motion">
                <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <TextBlock Text="MOUSE CURSOR TRAIL" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                        <CheckBox x:Name="CursorTrailToggle" Content="Show cursor trail" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Follows your mouse at display refresh, up to 120 Hz, independently of the music effects’ FPS. Works during silence; audio adds pulses. The preview shows sample movement." Style="{StaticResource HelpText}" Margin="0,5,0,9"/>
                        <StackPanel x:Name="CursorTrailPanel" Visibility="Collapsed">
                            <TextBlock Text="Trail style"/>
                            <ComboBox x:Name="CursorStylePicker" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Cursor trail style"/>
                            <StackPanel x:Name="CursorShapePanel" Visibility="Collapsed">
                                <TextBlock Text="Trail shape"/>
                                <ComboBox x:Name="CursorShapePicker" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Cursor trail shape"/>
                            </StackPanel>
                            <TextBlock x:Name="CursorLengthLabel"/>
                            <Slider x:Name="CursorLengthSlider" Minimum="150" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Cursor trail lifetime"/>
                            <TextBlock x:Name="CursorSizeLabel" Margin="0,7,0,0"/>
                            <Slider x:Name="CursorSizeSlider" Minimum="4" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Cursor trail size"/>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,12,0,12"/>
                        <TextBlock Text="ANIMATED SHAPES" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                        <CheckBox x:Name="ShapesToggle" Content="Show animated shapes" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Add a separate layer of geometric shapes. Choose its frequency range in Audio." Style="{StaticResource HelpText}" Margin="0,5,0,9"/>
                        <StackPanel x:Name="ShapesPanel" Visibility="Collapsed">
                            <TextBlock Text="Shape"/>
                            <ComboBox x:Name="ShapePicker" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Animated shape"/>
                            <TextBlock Text="Motion"/>
                            <ComboBox x:Name="ShapeMotionPicker" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Shape motion"/>
                            <CheckBox x:Name="FilledShapesToggle" Content="Fill shapes" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,9"/>
                            <TextBlock x:Name="ShapeCountLabel" Margin="0,7,0,0"/>
                            <Slider x:Name="ShapeCountSlider" Minimum="4" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Shapes"/>
                            <TextBlock x:Name="ShapeSizeLabel" Margin="0,7,0,0"/>
                            <Slider x:Name="ShapeSizeSlider" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Shape size"/>
                            <TextBlock x:Name="ShapeOpacityLabel" Margin="0,7,0,0"/>
                            <Slider x:Name="ShapeOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Shape opacity"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Audio">
                <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <TextBlock Text="FREQUENCY FOCUS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                        <UniformGrid x:Name="FocusChoices" Columns="3" Margin="0,0,-6,1">
                            <RadioButton GroupName="FrequencyFocus" Tag="Full" Content="Full mix" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrequencyFocus" Tag="Bass" Content="Bass" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrequencyFocus" Tag="Vocals" Content="Vocals" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrequencyFocus" Tag="Mids" Content="Mids" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrequencyFocus" Tag="Treble" Content="Treble" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                            <RadioButton GroupName="FrequencyFocus" Tag="Custom" Content="Custom" Style="{StaticResource Choice}" Checked="SettingsChanged"/>
                        </UniformGrid>
                        <TextBlock x:Name="FocusDescription" Style="{StaticResource HelpText}"/>
                        <StackPanel x:Name="RangePanel" Visibility="Collapsed" Margin="0,9,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="_From (Hz)" Target="{Binding ElementName=LowHzBox}" Foreground="{StaticResource Muted}" Padding="0,6,7,0"/>
                                <TextBox x:Name="LowHzBox" Width="69" MaxLength="5" TextChanged="SettingsChanged" AutomationProperties.Name="Low frequency in hertz"/>
                                <Label Content="_To (Hz)" Target="{Binding ElementName=HighHzBox}" Foreground="{StaticResource Muted}" Padding="13,6,7,0"/>
                                <TextBox x:Name="HighHzBox" Width="69" MaxLength="5" TextChanged="SettingsChanged" AutomationProperties.Name="High frequency in hertz"/>
                            </StackPanel>
                            <TextBlock x:Name="RangeError" Text="Use 40–13,000 Hz with at least 50 Hz between values." Foreground="#FFC28C"
                                       TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0">
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock x:Name="ResponseValue" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12"/>
                                <TextBlock Text="Response" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Slider x:Name="ResponseSlider" Minimum="50" Maximum="175" TickFrequency="5" IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True" AutomationProperties.Name="Response" ToolTip="How strongly the overlay moves with the selected frequencies." ValueChanged="SettingsChanged"/>
                        </StackPanel>
                        <TextBlock Text="AUDIO RANGE PER LAYER" Style="{StaticResource Eyebrow}" Margin="0,18,0,7"/>
                        <TextBlock Text="Choose what drives each part. Follow focus uses the range above; low, mid, high, and full mix work independently of it. Choose each image's range in Images." Style="{StaticResource HelpText}" Margin="0,0,0,9"/>
                        <TextBlock Text="Bars &amp; waves"/>
                        <ComboBox x:Name="BarsReaction" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Bars &amp; waves audio range"/>
                        <TextBlock Text="Circle"/>
                        <ComboBox x:Name="CircleReaction" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Circle audio range"/>
                        <TextBlock Text="Border"/>
                        <ComboBox x:Name="BorderReaction" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Border audio range"/>
                        <TextBlock Text="Overlay effects"/>
                        <ComboBox x:Name="EffectsReaction" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Overlay effects audio range"/>
                        <TextBlock Text="Animated shapes"/>
                        <ComboBox x:Name="ShapesReaction" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Animated shapes audio range"/>
                        <TextBlock Text="Cursor pulses"/>
                        <ComboBox x:Name="CursorReaction" Style="{StaticResource Selection}" SelectionChanged="SettingsChanged" AutomationProperties.Name="Cursor pulses audio range"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Colors">
                <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <TextBlock Text="COLOR SOURCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                        <UniformGrid x:Name="SourceChoices" Columns="3" Margin="0,0,-6,1">
                            <RadioButton GroupName="ColorSource" Tag="Palette" Content="Palette" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Use the selected preset or your two custom colors."/>
                            <RadioButton GroupName="ColorSource" Tag="Screen" Content="Screen" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Pick up colors from your primary display while the party is on."/>
                            <RadioButton GroupName="ColorSource" Tag="Mix" Content="Mix" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                         ToolTip="Combine screen colors with your selected palette. Adjust the ratio with Screen blend."/>
                        </UniformGrid>
                        <TextBlock x:Name="SourceDescription" Style="{StaticResource HelpText}"/>
                        <StackPanel x:Name="BlendPanel" Visibility="Collapsed" Margin="0,9,0,0">
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock x:Name="BlendValue" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12"/>
                                <TextBlock Text="Screen blend" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Slider x:Name="BlendSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True" AutomationProperties.Name="Screen blend" ValueChanged="SettingsChanged"
                                    ToolTip="0% uses only the palette. 100% uses only screen colors."/>
                        </StackPanel>
                        <StackPanel x:Name="PalettePanel" Margin="0,11,0,0">
                            <TextBlock Text="PALETTE" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                            <UniformGrid x:Name="PaletteChoices" Columns="4" Margin="0,0,-6,1">
                                <RadioButton GroupName="ColorTheme" Tag="Neon" Content="Neon" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                             ToolTip="Electric purple and cyan with hot pink accents."/>
                                <RadioButton GroupName="ColorTheme" Tag="Sunset" Content="Sunset" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                             ToolTip="Warm orange, gold, and pink."/>
                                <RadioButton GroupName="ColorTheme" Tag="Aurora" Content="Aurora" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                             ToolTip="Cool greens, cyan, and blue."/>
                                <RadioButton GroupName="ColorTheme" Tag="Custom" Content="Custom" Style="{StaticResource Choice}" Checked="SettingsChanged"
                                             ToolTip="Choose two colors with the color picker or enter their hex codes."/>
                            </UniformGrid>
                            <Grid x:Name="CustomColorsPanel" Visibility="Collapsed" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,17,0">
                                    <Button x:Name="FirstSwatch" Style="{StaticResource Swatch}" Click="PickColor"
                                            AutomationProperties.Name="Pick primary color" ToolTip="Pick primary color"/>
                                    <TextBox x:Name="FirstColorBox" Width="88" MaxLength="7" TextChanged="SettingsChanged"
                                             AutomationProperties.Name="Primary color hex code" ToolTip="Primary color · #RRGGBB"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SecondSwatch" Style="{StaticResource Swatch}" Click="PickColor"
                                            AutomationProperties.Name="Pick accent color" ToolTip="Pick accent color"/>
                                    <TextBox x:Name="SecondColorBox" Width="88" MaxLength="7" TextChanged="SettingsChanged"
                                             AutomationProperties.Name="Accent color hex code" ToolTip="Accent color · #RRGGBB"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ColorError" Text="Enter six hex digits, for example #B45CFF." Foreground="#FFC28C"
                                       Margin="0,5,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <CheckBox x:Name="AnimateToggle" Margin="0,9,0,0" Content="Cycle through colors"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"
                                  AutomationProperties.HelpText="{Binding Text, ElementName=CycleDescription}">
                            <CheckBox.ToolTip>
                                <TextBlock Width="280" TextWrapping="Wrap"
                                           Text="Turn this on to move colors through the overlay and shift them forward on beats. With cycling off, the visuals still react to music and keep their color assignments. Screen or Mix can still pick up changing screen colors."/>
                            </CheckBox.ToolTip>
                        </CheckBox>
                        <TextBlock x:Name="CycleDescription" Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="App">
                <ScrollViewer Style="{StaticResource SettingsScroll}">
                    <StackPanel>
                        <TextBlock Text="WINDOWS STARTUP" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="StartupToggle" Content="Start with Windows" Click="StartupClicked"
                                  ToolTip="Launch PartyTime in the system tray when you sign in to Windows."
                                  ToolTipService.ShowOnDisabled="True"
                                  AutomationProperties.HelpText="{Binding Text, ElementName=StartupDescription}"/>
                        <TextBlock x:Name="StartupDescription" Style="{StaticResource HelpText}" Margin="0,5,0,0"
                                   Text="PartyTime opens in the system tray at sign-in. Start the overlay when you're ready."/>
                        <TextBlock x:Name="StartupError" Foreground="#FFC28C" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,11,0,0" LastChildFill="False">
            <TextBlock x:Name="HotkeyLabel" Text="Ctrl + Alt + P  ·  Toggle overlay" Foreground="{StaticResource Accent}" FontSize="11"/>
            <TextBlock DockPanel.Dock="Right" Text="Closes to the tray" Foreground="{StaticResource Muted}" FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>
