{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Publish PartyTime (Windows x64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "PartyTime.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--self-contained", "true",
        "-p:PublishSingleFile=true",
        "-p:IncludeNativeLibrariesForSelfExtract=true",
        "-p:DebugType=None",
        "-o", "artifacts/win-x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
