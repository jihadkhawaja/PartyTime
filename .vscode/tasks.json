{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PartyTime (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "PartyTime.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish PartyTime (Windows x64)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Publish-Windows.ps1",
        "-Architecture",
        "x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish PartyTime (Windows ARM64)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Publish-Windows.ps1",
        "-Architecture",
        "arm64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish PartyTime (Linux x64)",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/publish.sh",
        "linux-x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish PartyTime (Linux ARM64)",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/publish.sh",
        "linux-arm64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish PartyTime (macOS Intel)",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/publish.sh",
        "osx-x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish PartyTime (macOS Apple Silicon)",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/publish.sh",
        "osx-arm64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
